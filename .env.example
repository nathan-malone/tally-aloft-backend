# Settings for running on the host. Copy this file to .env, then start the API
# with `uv run --env-file .env ...`. Durations are integer seconds, lists are
# comma-separated, and maps are JSON.

# The deployment: development, test, staging or production. Required.
TALLY_ENVIRONMENT=development

# Comma-separated addresses or networks of the proxies whose X-Forwarded-*
# headers are trusted. `*` is rejected. Default: 127.0.0.1.
TALLY_FORWARDED_ALLOW_IPS=127.0.0.1

# Settings for running on the host. Copy this file to .env, then start the API
# with `make api.run`, which loads it with `uv run --env-file .env ...`.
# Durations are integer seconds, lists are comma-separated, and maps are JSON.

# The deployment: development, test, staging or production. Required.
TALLY_ENVIRONMENT=development

# Comma-separated addresses or networks of the proxies whose X-Forwarded-*
# headers are trusted. `*` and catch-all networks such as 0.0.0.0/0 are
# rejected. Default: 127.0.0.1.
TALLY_FORWARDED_ALLOW_IPS=127.0.0.1

# Comma-separated browser origins that CORS allows, such as the web app's dev
# server. Each is exactly a lowercase scheme://host[:port], with no path and no
# default port; `*` is rejected. Default: none.
TALLY_CORS_ORIGINS=

# The application role's database, as a SQLAlchemy URL for asyncpg:
# postgresql+asyncpg://user:password@host:port/database, with reserved
# characters in the user and password percent-encoded. Required. This is the
# Compose Postgres, with its local development password.
TALLY_DATABASE_URL=postgresql+asyncpg://tally_aloft_app:tally_aloft_app@127.0.0.1:5432/tally_aloft

# Connections each process keeps in its pool, and how many more it may open
# when the pool is busy. Defaults: 5 and 5.
TALLY_DATABASE_POOL_SIZE=5
TALLY_DATABASE_MAX_OVERFLOW=5

# Seconds a statement may run before Postgres cancels it. Default: 30.
TALLY_DATABASE_STATEMENT_TIMEOUT=30

# The cache's Valkey: redis://[user:password@]host[:port][/database], or
# rediss:// for TLS, which staging and production require, with a password.
# No query, and reserved characters in the user and password percent-encoded.
# Required. This is the Compose Valkey, which has no password.
TALLY_VALKEY_URL=redis://127.0.0.1:6379/0

# Seconds a worker's message may go unacknowledged before another worker may
# reclaim it; it must exceed every task's timeout. Default: 900.
TALLY_BROKER_IDLE_TIMEOUT=900

# The approximate length the broker's stream is trimmed to. Default: 100000.
TALLY_BROKER_STREAM_MAXLEN=100000

# The owner role's database, in TALLY_DATABASE_URL's format, for migrations
# only. The API never reads it, though it shares this file on the host.
# Required for migrations.
TALLY_MIGRATION_DATABASE_URL=postgresql+asyncpg://tally_aloft_owner:tally_aloft_owner@127.0.0.1:5432/tally_aloft

# Seconds a migration waits for a lock before it fails. Default: 5.
TALLY_MIGRATION_LOCK_TIMEOUT=5
